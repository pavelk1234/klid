{
  "name": "klid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "d1:create": "wrangler d1 create klid-dev",
    "d1:migrate:local": "wrangler d1 execute klid-dev --local --file=migrations/0001_initial.sql",
    "d1:migrate:remote": "wrangler d1 execute klid-dev --remote --file=migrations/0001_initial.sql",
    "cron:dev": "wrangler dev workers/reminder-cron.ts --test-scheduled"
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "jose": "^5.9.6",
    "resend": "^4.0.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.453.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@opennextjs/cloudflare": "^1.19.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/node": "^22.7.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "wrangler": "^4.86.0"
  }
}
