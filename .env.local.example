# Klid — local environment variables
# Copy this to .env.local and fill in real values.

# Sign cookies & magic-link tokens — generate with: openssl rand -base64 32
JWT_SECRET=replace_me_with_32_byte_random_string

# Resend transactional email — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Sender shown in the From: header. Use onboarding@resend.dev for sandbox.
EMAIL_FROM=Klid <hello@klid.app>

# Public origin used to build magic-link and reminder URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: the D1 database is bound automatically by wrangler/next-on-pages.
# See wrangler.toml for the binding name (DB).
